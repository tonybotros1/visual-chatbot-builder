POSTGRES_DB=visual_chatbot
POSTGRES_USER=visual_chatbot
POSTGRES_PASSWORD=visual_chatbot_dev
DATABASE_URL=postgresql+psycopg://visual_chatbot:visual_chatbot_dev@postgres:5432/visual_chatbot
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# JSON list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3100","http://127.0.0.1:3100"]
# Admin console (separate app/container) public URL.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3100
SECRET_KEY=change-this-to-a-long-random-value-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_SIZE_MB=25
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# Platform super admin: created on first start, password re-applied on every start. Change both before any shared deployment.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-admin-password
SUPER_ADMIN_NAME=Platform admin
# Seeds the sample "Eligibility demo" bot and "Consent decision" component under the super admin.
SEED_DEMO_DATA=true
