POSTGRES_DB=visual_chatbot
POSTGRES_USER=visual_chatbot
POSTGRES_PASSWORD=visual_chatbot_dev
DATABASE_URL=postgresql+psycopg://visual_chatbot:visual_chatbot_dev@postgres:5432/visual_chatbot
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# JSON list of browser origins allowed to call the API. Private LAN addresses (10.x, 192.168.x, 172.16-31.x,
# *.local) are accepted automatically so the app can be opened from other computers on the network;
# set CORS_ORIGIN_REGEX to narrow or widen that.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGIN_REGEX=
# Extra hostnames/IPs allowed to load the dev server from another machine (comma-separated); LAN ranges are built in.
ALLOWED_DEV_ORIGINS=
SECRET_KEY=change-this-to-a-long-random-value-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
UPLOAD_DIRECTORY=data/uploads
MAX_UPLOAD_SIZE_MB=25
# Azure Blob Storage for visitor uploads. Fill the connection string OR the name + key; leave empty to keep
# files on the server disk under UPLOAD_DIRECTORY. The container is created on first upload.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=spaghetti-uploads
AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# Platform super admin: created on first start, password re-applied on every start. Change both before any shared deployment.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-this-admin-password
SUPER_ADMIN_NAME=Platform admin
# Seeds the sample "Eligibility demo" bot and "Consent decision" component under the super admin.
SEED_DEMO_DATA=true
