# Settings for docker-compose.prod.yml. Copy to .env on the server and fill in; never commit the real file.
# The address visitors use, without a trailing slash. Share links and the API URL follow it.
PUBLIC_URL=https://chat.example.com
# Only when the app lives under a sub-path: PUBLIC_URL=https://example.com/spaghetti, BASE_PATH=/spaghetti
# and PUBLIC_ORIGIN=https://example.com (scheme and host only).
BASE_PATH=
PUBLIC_ORIGIN=

POSTGRES_DB=visual_chatbot
POSTGRES_USER=visual_chatbot
POSTGRES_PASSWORD=change-me-long-random

# Long random value. It signs sign-in tokens and encrypts stored integration credentials, so keep the
# same value when moving a database between servers.
SECRET_KEY=change-me-long-random

# Platform owner: created on first start, password re-applied on every start.
SUPER_ADMIN_EMAIL=owner@example.com
SUPER_ADMIN_PASSWORD=change-me-strong
SUPER_ADMIN_NAME=Platform admin

# false = no public sign-up; admins create accounts in the admin console (recommended on the internet).
ALLOW_REGISTRATION=false

# Azure Blob Storage for visitor uploads (optional; uploads stay on the server volume when empty).
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=spaghetti-uploads
AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net
